<root id="app" padding="32" gap="20" align="center" justify="center">
  <label id="counter" class="display" width="100%" height="120px" text="0" bind-text="clicks" />
  <row gap="14" justify="center">
    <button id="bump" class="primary" width="120px" height="48px" text="+1" />
    <button id="reset" class="primary" width="120px" height="48px" text="reset" />
  </row>
</root>
